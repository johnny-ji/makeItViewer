{
  "name": "markdown-mermaid-viewer",
  "version": "1.0.0",
  "description": "Markdown and Mermaid desktop viewer",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "39.7.0",
    "electron-builder": "26.0.12"
  },
  "dependencies": {
    "iconv-lite": "^0.7.0"
  },
  "build": {
    "appId": "com.makeitviewer.markdown",
    "productName": "MarkdownViewer",
    "electronDist": "node_modules/electron/dist",
    "directories": { "output": "release" },
    "files": ["main.js", "preload.js", "src/**/*", "renderer/**/*", "package.json"],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "MarkdownViewer.Markdown",
        "description": "Markdown document",
        "role": "Viewer"
      }
    ],
    "win": { "target": ["nsis", "portable"], "signAndEditExecutable": false }
  }
}
